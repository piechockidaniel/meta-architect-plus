<style>
  .fc-root { width: 600px; flex-direction: column; padding-top: 24px; padding-bottom: 24px; padding-left: 24px; padding-right: 24px; gap: 10px; background-color: #14171F; border-width: 1px; border-color: #37566A; border-radius: 24px; }
  .fc-header { flex-direction: row; justify-content: space-between; align-items: center; gap: 12px; }
  .fc-title { font-size: 30px; line-height: 36px; font-weight: 700; color: #E6ECF2; }
  .fc-body { font-size: 23px; line-height: 31px; color: #E6ECF2; }
  .fc-muted { font-size: 18px; line-height: 24px; color: #9EACB9; }
  .fc-row { flex-direction: row; justify-content: center; gap: 16px; align-items: center; }
  .fc-card { flex-direction: column; gap: 12px; min-height: 100px; padding-top: 16px; padding-bottom: 16px; padding-left: 16px; padding-right: 16px; border-radius: 16px; background-color: #1D293A; border-width: 1px; border-color: #354A61; }
  .fc-grow { flex-grow: 1; }
  .fc-mark { width: 64px; height: 64px; align-items: center; justify-content: center; flex-shrink: 0; }
  .fc-mark-shape { position-type: absolute; width: 64px; height: 64px; }
  .fc-mark-nexus { width: 7px; height: 7px; border-radius: 4px; background-color: #E6ECF2; z-index-offset: 1; }
  .fc-choice-row { flex-direction: row; gap: 10px; }
  .fc-answers { flex-direction: column; gap: 10px; }
  .fc-choice { flex-grow: 1; flex-basis: 0; min-height: 46px; background-color: #233247; border-width: 1px; border-color: #43566F; }
  .fc-button-label { color: #E6ECF2; font-size: 18px; }
  .fc-title-row { flex-direction: row; align-items: center; gap: 12px; }
  .fc-category { width: 36px; height: 36px; color: #00D2FF; }
  .fc-button { background-color: #233247; border-width: 1px; border-color: #43566F; }
</style>
<Panel id="fc-root"><div class="fc-root">
  <div class="fc-header">
    <div class="fc-mark">
      <svg id="fc-mark-shape" class="fc-mark-shape" src="/assets/branding/app-mark-spatial.svg"></svg>
      <div id="fc-mark-nexus" class="fc-mark-nexus"></div>
    </div>
    <div id="fc-location" class="fc-muted fc-grow">Architecture workspace</div>
    <Button class="fc-button" id="fc-menu" variant="tertiary"><ButtonLabel class="fc-button-label">Menu</ButtonLabel></Button>
  </div>
  <div class="fc-title-row"><Cloud id="fc-icon-deployment" class="fc-category" style="display: none"></Cloud><Database id="fc-icon-dataLocation" class="fc-category" style="display: none"></Database><ShieldCheck id="fc-icon-identity" class="fc-category" style="display: none"></ShieldCheck><Server id="fc-icon-capacity" class="fc-category" style="display: none"></Server><Network id="fc-icon-connectivity" class="fc-category" style="display: none"></Network><Gauge id="fc-icon-latency" class="fc-category" style="display: none"></Gauge><UserRound id="fc-icon-operator" class="fc-category" style="display: none"></UserRound><RotateCcw id="fc-icon-recovery" class="fc-category" style="display: none"></RotateCcw><TrendingUp id="fc-icon-usage" class="fc-category" style="display: none"></TrendingUp><div id="fc-title" class="fc-title">One decision at a time</div></div>
  <div id="fc-subtitle" class="fc-muted">-</div>
  <div class="fc-card">
    <div id="fc-line-0" class="fc-body">-</div>
    <div id="fc-line-1" class="fc-body">-</div>
    <div id="fc-line-2" class="fc-muted">-</div>
  </div>
  <div id="fc-answers" class="fc-answers" style="display: none"><div class="fc-choice-row"><Button id="fc-answer-0" class="fc-choice" variant="tertiary"><ButtonLabel class="fc-button-label" id="fc-answer-0-label">-</ButtonLabel></Button><Button id="fc-answer-1" class="fc-choice" variant="tertiary"><ButtonLabel class="fc-button-label" id="fc-answer-1-label">-</ButtonLabel></Button></div><div class="fc-choice-row"><Button id="fc-answer-2" class="fc-choice" variant="tertiary"><ButtonLabel class="fc-button-label" id="fc-answer-2-label">-</ButtonLabel></Button><Button id="fc-answer-3" class="fc-choice" variant="tertiary"><ButtonLabel class="fc-button-label" id="fc-answer-3-label">-</ButtonLabel></Button></div><div class="fc-choice-row"><Button id="fc-answer-4" class="fc-choice" variant="tertiary"><ButtonLabel class="fc-button-label" id="fc-answer-4-label">-</ButtonLabel></Button></div></div>
  <div id="fc-navigation" class="fc-row">
    <Button class="fc-button" id="fc-left" variant="tertiary"><ButtonLabel class="fc-button-label">Previous option</ButtonLabel></Button>
    <div id="fc-position" class="fc-muted">1 / 3</div>
    <Button class="fc-button" id="fc-right" variant="tertiary"><ButtonLabel class="fc-button-label">Next option</ButtonLabel></Button>
  </div>
  <div id="fc-sections" class="fc-row">
    <Button class="fc-button" id="fc-up" variant="tertiary"><ButtonLabel class="fc-button-label">Previous section</ButtonLabel></Button>
    <Button class="fc-button" id="fc-down" variant="tertiary"><ButtonLabel class="fc-button-label">Next section</ButtonLabel></Button>
  </div>
  <div class="fc-row">
    <Button class="fc-button" id="fc-primary" variant="primary"><ButtonLabel class="fc-button-label" id="fc-primary-label">Start</ButtonLabel></Button>
    <Button class="fc-button" id="fc-secondary" variant="tertiary"><ButtonLabel class="fc-button-label" id="fc-secondary-label">Resume</ButtonLabel></Button>
  </div>
  <div class="fc-row">
    <Button class="fc-button" id="fc-back" variant="tertiary"><ButtonLabel class="fc-button-label">Back</ButtonLabel></Button>
    <Button class="fc-button" id="fc-close" variant="tertiary"><ButtonLabel class="fc-button-label">Close</ButtonLabel></Button>
  </div>
  <div id="fc-status" class="fc-muted">-</div>
</div></Panel>
